{
  "name": "placement-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm.cmd run dev --workspace=server\" \"npm.cmd run dev --workspace=client\"",
    "dev:server": "npm.cmd run dev --workspace=server",
    "dev:client": "npm.cmd run dev --workspace=client",
    "build": "npm.cmd run build --workspace=server && npm.cmd run build --workspace=client",
    "seed": "npm.cmd run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
